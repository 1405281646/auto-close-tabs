{
  "manifest_version": 3,
  "name": "自动关闭标签页",
  "version": "1.0.0",
  "description": "配置哪些网页在打开指定时间后自动关闭标签页",
  "permissions": ["tabs", "storage", "alarms", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "自动关闭标签页设置"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
